@page
@model HairdresserAppointmentClient.Pages.Booking.CreateBookingModel
@{
}



<div class="vh-100">

    <img src="~/images/frisörhylla.png" class="position-fixed top-0 start-0 w-100 h-100 object-fit-cover d-block opacity-50" style="margin-top: -50px;" />

    <div class="container position-fixed m-5">

                <div class="row g-5">


                    <!-- Bekräfta bokning kortet -->

                    <div class="col-lg-7">
                        <div class="bg-dark rounded-5 shadow-lg p-5">
                            <div class="mb-5">
                                <h2 class="fw-bold text-gold"> Bekräfta bokning</h2>
                                <p class="text-white"> Fyll i dina uppgifter för att slutföra bokningen.</p>
                            </div>

                            <form method="post" asp-page-handler="CreateBooking">
                                <input type="hidden" asp-for="Booking.HairdresserId" value="@Model.HairdresserId" />
                                <input type="hidden" asp-for="Booking.StartTime" value="@Model.StartTime" />
                                <input type="hidden" asp-for="Booking.EndTime" value="@Model.EndTime" />
                                @foreach (var id in Model.TreatmentIds)
                                {
                                    <input type="hidden" asp-for="Booking.TreatmentIds" value="@id" />
                                }
                                <div class="row">
                                    <div class="col-md-12 mb-2">
                                        <label class="form-label fw-bold text-gold"> Fullständigt namn</label>
                                        <input asp-for="Booking.CustomerName" class="form-control rounded-2" required />
                                    </div>
                                    <div class="col-md-7 mb-4">
                                        <label class="form-label fw-bold text-gold"> E-postadress </label>
                                        <input asp-for="Booking.CustomerEmail" type="email" class="form-control rounded-2" required />
                                    </div>
                                    <div class="col-md-5 mb-4">
                                        <label class="form-label fw-bold text-gold"> Telefonnummer</label>
                                        <input asp-for="Booking.CustomerPhone" class="form-control rounded-2" required />
                                    </div>
                                </div>
                                <button type="submit" id="goldenBtn"> Bekräfta bokningen</button>
                            </form>
                        </div>
                    </div>


                    <!-- Boknings info kortet -->
                    <div class="col-lg-4 ms-auto">
                        <div class="bg-dark text-white rounded-5 shadow-lg p-4">
                            <div class="mb-5">
                                <h3 class="fw-bold text-gold mb-0">Din bokning</h3>
                            </div>
                            <div class="mb-4">
                                <small class="text-grey small mb-2">FRISÖR</small>
                                <div class="fs-5 fw-semibold"> @Model.SelectedHairdresser!.Name</div>
                            </div>


                    <div class="d-flex justify-content-between mb-2">
                        <span>Datum</span>
                        <span> @Model.StartTime.ToString("d")</span>
                    </div>
                    <div class="d-flex justify-content-between mb-2">
                        <span>Tid</span>
                        <span> @Model.StartTime.ToString("t")</span>
                    </div>







                            
                            <div class="mb-4">
                                <div class="small text-grey mb-3">BEHANDLIGAR</div>
                                @foreach (var treatment in Model.SelectedTreatments)
                                {
                                    <div class="d-flex justify-content-between mb-2">
                                        <span> ✂ @treatment.Name</span>
                                        <span> @treatment.Price.ToString("0") kr</span>
                                    </div>
                                }
                            </div>

                            <div class="border-top border-secondary pt-4">
                                <div class="d-flex justify-content-between mb-2">
                                    <span> Total tid</span>
                                    <span> @Model.TotalTime min</span>
                                </div>

                                <div class="d-flex justify-content-between align-items-center">
                                    <span>Total pris</span>
                                    <span class="fs-3 fw-bold text-gold"> @Model.TotalPrice.ToString("0") kr</span>
                                </div>
                            </div>

                        </div>

                    </div>


                </div>


        
    </div>

</div>


